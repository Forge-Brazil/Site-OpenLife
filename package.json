{
  "name": "openlife-english-school",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:courses-pdf": "node scripts/generate-courses-pdf.mjs",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr entry-server.tsx --outDir dist/server",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run generate:courses-pdf && npm run build:client && npm run build:server && npm run prerender",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "start": "node server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.563.0",
    "motion": "^12.38.0",
    "pdfkit": "^0.19.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
