# Supabase — persistência de newsletter e leads (opcional; sem isso o site
# funciona normalmente, só não salva/envia e-mails)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

