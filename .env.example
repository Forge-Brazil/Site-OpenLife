# Supabase — persistência de newsletter e leads (opcional; sem isso o site
# funciona normalmente, só não salva/envia e-mails)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Resend — envio de e-mail de boas-vindas (newsletter) e notificação de lead
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=openlifebrazil@gmail.com

# Groq — chat da Alice, consultora de IA (server.js, POST /api/alice/chat).
# Roda só no servidor: a chave nunca vai pro navegador.
GROQ_API_KEY=your_groq_api_key

# Formulário de contato — encaminha o lead pro CRM do ERP (POST /api/leads/site).
# Sem isso, o lead cai no fallback local (Supabase acima) em vez do CRM real.
ERP_API_URL=https://erp.openlifebrasil.com.br
# Mesmo valor configurado como SITE_SHARED_SECRET no servidor do ERP.
SITE_SHARED_SECRET=your_shared_secret
